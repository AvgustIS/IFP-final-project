@inherits LayoutComponentBase
@implements IDisposable
@inject CartState Cart
<header class="topbar"><div class="container nav"><a class="brand" href="/">✦ EasyShop<span>KZ</span></a><nav class="links"><a href="/">Home</a><a href="/catalog">Catalog</a><a href="/cart">Cart <span class="count">@Cart.Count</span></a><AuthorizeView><Authorized><a href="/orders">My Orders</a><AuthorizeView Roles="Admin" Context="adminContext"><a href="/admin">Admin</a></AuthorizeView><span class="hello">Hi, @context.User.Identity?.Name</span><form action="/auth/logout" method="post" class="inline"><AntiforgeryToken/><button type="submit" class="link-button">Logout</button></form></Authorized><NotAuthorized><a href="/login">Sign In</a><a class="nav-cta" href="/register">Join now</a></NotAuthorized></AuthorizeView></nav></div></header>
<main data-ready="@(ready||StaticPage?"true":"false")"><fieldset class="interactive-content" disabled="@(!ready&&!StaticPage)">@Body</fieldset></main><footer><div class="container footer-inner"><span>✦ EasyShop KZ</span><span>Simple shopping, done right. · Student project · 2026</span></div></footer>
@code {[CascadingParameter] private HttpContext? HttpContext {get;set;}private bool ready;private bool StaticPage=>HttpContext is not null&&!HttpContext.AcceptsInteractiveRouting(); protected override void OnInitialized()=>Cart.Changed+=Refresh;protected override async Task OnAfterRenderAsync(bool firstRender){if(firstRender){await Cart.InitializeAsync();ready=true;StateHasChanged();}}private void Refresh()=>_ = InvokeAsync(StateHasChanged);public void Dispose()=>Cart.Changed-=Refresh; }
