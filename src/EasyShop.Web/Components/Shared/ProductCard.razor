<article class="product-card"><a class="product-picture" href="/product/@Item.Id"><img src="@Item.ImageUrl" alt="@Item.Name" loading="lazy"/></a><div class="product-info"><div class="muted small">@Item.Category?.Name</div><h3><a href="/product/@Item.Id">@Item.Name</a></h3><div class="product-bottom"><strong>@Item.Price.ToString("N0") ₸</strong><span class="stock">@(Item.Stock>0?$"{Item.Stock} left":"Out of stock")</span></div><button class="btn primary full" disabled="@(Item.Stock<=0)" @onclick="()=>Cart.Add(Item)">@(Item.Stock>0?"Add to cart":"Sold out")</button></div></article>
@code {[Parameter,EditorRequired] public Product Item {get;set;}=default!;[Inject] private CartState Cart {get;set;}=default!;}
