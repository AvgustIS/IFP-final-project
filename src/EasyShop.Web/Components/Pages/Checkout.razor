@implements IDisposable
@page "/checkout"
@attribute [Authorize]
@inject CartState Cart
@inject ShopService Shop
@inject AuthenticationStateProvider Auth
@inject NavigationManager Navigation
<div class="container section"><div class="page-heading"><span class="eyebrow dark">ONE LAST STEP</span><h1>Checkout</h1></div>@if(Cart.Items.Count==0){<div class="empty"><p>Your cart is empty.</p><a href="/catalog">Shop now</a></div>}else{<div class="checkout-grid"><div class="panel"><h2>Delivery information</h2><div class="form-grid"><label>Full name<input @bind="name" maxlength="120" placeholder="Your name"/></label><label>Phone number<input @bind="phone" maxlength="35" placeholder="+7 ..."/></label><label>Delivery address<textarea @bind="address" maxlength="300" placeholder="Street, building, apartment"></textarea></label><label>Payment method<select @bind="payment"><option>Cash on Delivery</option><option>Demo Card</option></select></label></div><p class="muted small">Demo Card is a simulation. No real payment is processed.</p>@if(!string.IsNullOrEmpty(message)){<div class="alert">@message</div>}<button class="btn primary" disabled="@submitting" @onclick="PlaceOrder">@(submitting?"Placing order...":"Place order")</button></div><aside class="panel summary"><h2>Your order</h2>@foreach(var item in Cart.Items){<div class="sum-row"><span>@item.Name × @item.Quantity</span><span>@((item.UnitPrice*item.Quantity).ToString("N0")) ₸</span></div>}<hr/><div class="sum-row"><strong>Total</strong><h2>@Cart.Total.ToString("N0") ₸</h2></div></aside></div>}</div>
@code {protected override void OnInitialized()=>Cart.Changed+=Refresh;private string name="",phone="",address="",payment="Cash on Delivery",message="";private bool submitting;private async Task PlaceOrder(){if(submitting)return;submitting=true;try{var user=(await Auth.GetAuthenticationStateAsync()).User;if(!int.TryParse(user.FindFirstValue(ClaimTypes.NameIdentifier),out int id)){message="Sign in to place an order.";return;}var result=await Shop.CheckoutAsync(id,Cart.Items,new CheckoutDetails(name,phone,address,payment));if(result.Success){await Cart.Clear();Navigation.NavigateTo($"/order-success/{result.Id}");}else message=result.Message;}finally{submitting=false;}}private void Refresh()=>_ = InvokeAsync(StateHasChanged);public void Dispose()=>Cart.Changed-=Refresh;}
