@implements IDisposable
@page "/cart"
@inject CartState Basket
@inject ShopService Shop
<div class="container section"><div class="page-heading"><span class="eyebrow dark">YOUR SELECTION</span><h1>Shopping cart</h1></div>@if(Basket.Items.Count==0){<div class="empty"><h2>Your cart is empty</h2><p>Discover something you love.</p><a class="btn primary" href="/catalog">Browse products</a></div>}else{<div class="checkout-grid"><div class="panel">@foreach(var item in Basket.Items){<div class="cart-row"><img src="@item.ImageUrl" alt="@item.Name"/><div><strong>@item.Name</strong><div class="muted">@item.UnitPrice.ToString("N0") ₸ each</div><button class="link-button danger" @onclick="()=>Basket.Remove(item.ProductId)">Remove</button></div><div class="qty"><button aria-label="Decrease" @onclick="()=>Change(item,-1)">−</button><span>@item.Quantity</span><button aria-label="Increase" @onclick="()=>Change(item,1)">+</button></div><strong>@((item.UnitPrice*item.Quantity).ToString("N0")) ₸</strong></div>}</div><aside class="panel summary"><h2>Order summary</h2><div class="sum-row"><span>Items (@Basket.Count)</span><strong>@Basket.Total.ToString("N0") ₸</strong></div><hr/><div class="sum-row"><strong>Total</strong><h2>@Basket.Total.ToString("N0") ₸</h2></div><a class="btn primary full" href="/checkout">Proceed to checkout →</a><a class="text-link" href="/catalog">Continue shopping</a></aside></div>}</div>
@code {private readonly Dictionary<int,int> stock=new();protected override async Task OnInitializedAsync(){Basket.Changed+=Refresh;foreach(var p in await Shop.ProductsAsync())stock[p.Id]=p.Stock;}private Task Change(CartLine line,int amount)=>Basket.Change(line.ProductId,line.Quantity+amount,stock.GetValueOrDefault(line.ProductId,0));private void Refresh()=>_ = InvokeAsync(StateHasChanged);public void Dispose()=>Basket.Changed-=Refresh;}
