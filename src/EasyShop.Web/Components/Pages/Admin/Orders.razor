@page "/admin/orders"
@attribute [Authorize(Roles="Admin")]
@inject ShopService Shop
<div class="container section"><a href="/admin">← Dashboard</a><h1>Manage orders</h1>@if(message!=""){<p class="alert">@message</p>}@if(orders.Count==0){<div class="empty">No orders have been placed yet.</div>}@foreach(var order in orders){<article class="panel order-card"><div class="order-head"><strong>#@order.Id · @order.CustomerName</strong><span class="pill">@order.Status</span><span>@order.Total.ToString("N0") ₸</span><span>@order.CreatedUtc.ToLocalTime().ToString("g")</span></div><p class="muted">@order.Address · @order.Phone · @order.PaymentMethod</p>@foreach(var item in order.Items){<div class="sum-row"><span>@item.Name × @item.Quantity</span><span>@item.UnitPrice.ToString("N0") ₸ each</span></div>}<div class="admin-links">@if(order.Status=="Pending"){<button class="btn outline small" @onclick="()=>Change(order.Id,ProcessingStatus)">Mark Processing</button><button class="btn danger-btn small" @onclick="()=>Change(order.Id,CancelledStatus)">Cancel</button>}@if(order.Status=="Processing"){<button class="btn primary small" @onclick="()=>Change(order.Id,CompletedStatus)">Complete</button><button class="btn danger-btn small" @onclick="()=>Change(order.Id,CancelledStatus)">Cancel</button>}</div></article>}</div>
@code {private const string ProcessingStatus="Processing",CompletedStatus="Completed",CancelledStatus="Cancelled";private List<ShopOrder> orders=[];private string message="";protected override async Task OnInitializedAsync()=>await Load();private async Task Load()=>orders=await Shop.OrdersAsync();private async Task Change(int id,string next){var r=await Shop.ChangeStatusAsync(id,next);message=r.Message;await Load();}}
