@page "/admin/products"
@attribute [Authorize(Roles="Admin")]
@inject ShopService Shop
<div class="container section"><a href="/admin" class="text-link">← Dashboard</a><h1>Manage products</h1><div class="checkout-grid"><div class="panel"><h2>@(draft.Id==0?"Add product":"Edit product")</h2><div class="form-grid"><label>Name<input @bind="draft.Name" maxlength="140"/></label><label>Description<textarea @bind="draft.Description"></textarea></label><label>Price (₸)<input type="number" min="1" max="99999999" step="0.01" @bind="draft.Price"/></label><label>Stock<input type="number" min="0" @bind="draft.Stock"/></label><label>Category<select aria-label="Category" @bind="draft.CategoryId">@foreach(var c in categories){<option value="@c.Id">@c.Name</option>}</select></label><label>Image URL<input @bind="draft.ImageUrl"/></label></div>@if(message!=""){<div class="alert">@message</div>}<button class="btn primary" @onclick="Save">Save product</button><button class="btn outline" @onclick="Reset">Clear</button></div><div class="panel"><h2>Products (@products.Count)</h2><div class="admin-items">@foreach(var p in products){<div class="admin-item"><img src="@p.ImageUrl" alt=""/><div><strong>@p.Name</strong><div class="muted small">@p.Price.ToString("N0") ₸ · Stock @p.Stock</div></div><button class="btn outline small" @onclick="()=>Edit(p)">Edit</button><button class="btn danger-btn small" @onclick="()=>Delete(p.Id)">Delete</button></div>}</div></div></div></div>
@code {private List<Product> products=[];private List<Category> categories=[];private Product draft=new();private string message="";protected override async Task OnInitializedAsync(){categories=await Shop.CategoriesAsync();await Load();Reset();}private async Task Load()=>products=await Shop.ProductsAsync();private void Edit(Product p){draft=new Product{Id=p.Id,Name=p.Name,Description=p.Description,Price=p.Price,Stock=p.Stock,CategoryId=p.CategoryId,ImageUrl=p.ImageUrl};message="";}private void Reset(){draft=new Product{CategoryId=categories.FirstOrDefault()?.Id??0};message="";}private async Task Save(){var result=await Shop.SaveProductAsync(draft);message=result.Message;if(result.Success){await Load();draft=new Product{CategoryId=categories.FirstOrDefault()?.Id??0};}}private async Task Delete(int id){var result=await Shop.DeleteProductAsync(id);message=result.Message;if(result.Success)await Load();}}
