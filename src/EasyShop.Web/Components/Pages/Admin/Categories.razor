@page "/admin/categories"
@attribute [Authorize(Roles="Admin")]
@inject ShopService Shop
<div class="container section"><a href="/admin">← Dashboard</a><h1>Manage categories</h1><div class="panel narrow"><div class="form-grid"><label>Category name<input @bind="draft.Name" maxlength="80"/></label></div><button class="btn primary" @onclick="Save">@(draft.Id==0?"Add category":"Save changes")</button><button class="btn outline" @onclick="Reset">Clear</button>@if(message!=""){<p class="alert">@message</p>}</div><div class="panel narrow">@foreach(var c in categories){<div class="admin-item"><strong>@c.Name</strong><button class="btn outline small" @onclick="()=>Edit(c)">Edit</button><button class="btn danger-btn small" @onclick="()=>Delete(c.Id)">Delete</button></div>}</div></div>
@code {private List<Category> categories=[];private Category draft=new();private string message="";protected override async Task OnInitializedAsync()=>await Load();private async Task Load()=>categories=await Shop.CategoriesAsync();private void Edit(Category c){draft=new Category{Id=c.Id,Name=c.Name};message="";}private void Reset(){draft=new();message="";}private async Task Save(){var r=await Shop.SaveCategoryAsync(draft);message=r.Message;if(r.Success){await Load();draft=new();}}private async Task Delete(int id){var r=await Shop.DeleteCategoryAsync(id);message=r.Message;if(r.Success)await Load();}}
