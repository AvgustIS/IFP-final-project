@page "/catalog"
@inject ShopService Shop
<PageTitle>Catalog — EasyShop KZ</PageTitle>
<div class="container section"><div class="page-heading"><span class="eyebrow dark">DISCOVER EASYSHOP</span><h1>Shop all products</h1><p>Everything you need, in one easy place.</p></div>
<div class="filters"><input aria-label="Search products" placeholder="Search products..." @bind="search" @bind:event="oninput"/><select aria-label="Category" @bind="category"><option value="0">All categories</option>@foreach(var c in categories){<option value="@c.Id">@c.Name</option>}</select><select aria-label="Sort" @bind="sort"><option value="default">Featured</option><option value="low">Price: low to high</option><option value="high">Price: high to low</option></select><label class="check"><input type="checkbox" @bind="inStock"/> In stock</label><button class="btn outline" @onclick="Reset">Reset</button></div>
<p class="muted">@Filtered.Count() products found</p><div class="product-grid">@foreach(var p in Filtered){<ProductCard Item="p"/>}</div>@if(!Filtered.Any()){<div class="empty">No products found. Try clearing your filters.</div>}</div>
@code {private List<Product> products=[];private List<Category> categories=[];private string search="",sort="default";private int category;private bool inStock;private IEnumerable<Product> Filtered=>ShopRules.Filter(products,search,category==0?null:category,sort,inStock);protected override async Task OnInitializedAsync(){products=await Shop.ProductsAsync();categories=await Shop.CategoriesAsync();}private void Reset(){search="";sort="default";category=0;inStock=false;}}
