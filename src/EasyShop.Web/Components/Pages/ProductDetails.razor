@page "/product/{Id:int}"
@inject ShopService Shop
@inject CartState Cart
<div class="container section"><a class="text-link" href="/catalog">← Back to catalog</a>@if(product is null){<div class="empty">Product not found.</div>}else{<div class="detail"><div class="detail-image"><img src="@product.ImageUrl" alt="@product.Name"/></div><div><span class="eyebrow dark">@product.Category?.Name</span><h1>@product.Name</h1><p>@product.Description</p><h2>@product.Price.ToString("N0") ₸</h2><p class="muted">@(product.Stock>0?$"{product.Stock} units available":"Currently sold out")</p><button class="btn primary" disabled="@(product.Stock<=0)" @onclick="Add">Add to cart</button>@if(added){<p class="success">Added! <a href="/cart">Go to cart →</a></p>}</div></div>}</div>
@code {[Parameter]public int Id {get;set;}private Product? product;private bool added;protected override async Task OnParametersSetAsync(){product=await Shop.ProductAsync(Id);added=false;}private async Task Add(){if(product is not null){await Cart.Add(product);added=true;}}}
